# Optional overrides for docker-compose. Copy to .env and edit.
# Every value shown here is already the default.

# Transcription engine label and language hint
ENGINE=faster-whisper
LANGUAGE=en

# faster-whisper model (used when TRANSCRIBE_COMMAND is empty).
# The first transcription downloads the model inside the container.
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8

# Custom local transcription command. {file} is replaced with the uploaded
# audio path; stdout becomes the transcript. Overrides faster-whisper.
# TRANSCRIBE_COMMAND=

# API/WebSocket bearer token. Leave empty to auto-generate one into the
# Docker volume at /data/auth_token on first start.
# VOICE_MODULE_AUTH_TOKEN=

# Limits
MAX_UPLOAD_BYTES=26214400
MAX_TRANSCRIPTIONS_PER_MINUTE=10
